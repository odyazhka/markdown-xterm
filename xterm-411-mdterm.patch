+/* ------------------------------------------------------------------ */
+/* mdterm: markdown -> ANSI filter between read(pty) and the VT parser */
+/* ------------------------------------------------------------------ */
+
+#define MDTERM_SHORT_USEC 40000L	/* prompts / echoed keys: flush after 40ms idle */
+#define MDTERM_KEY_USEC   300000L	/* "a key was just pressed" window */
+#define MDTERM_HOLD_DEFAULT_MS 2000L	/* ordinary partial line: flush after 2s idle */
+#define MDTERM_STREAM_DEFAULT_MS 60000L	/* slow LLM-style stream running: wait up to 60s */
+
+static void *md_state = NULL;
+static int md_enabled = -1;		/* -1 = not decided yet */
+static int md_holding = 0;		/* partial line currently held in Rust? */
+static struct timeval md_last_input;	/* last time a partial line was held */
+static struct timeval md_last_key;	/* last time the user wrote to the pty */
+static long md_hold_usec = MDTERM_HOLD_DEFAULT_MS * 1000L;
+static long md_stream_usec = MDTERM_STREAM_DEFAULT_MS * 1000L;
+
+static unsigned char *md_scratch = NULL;	/* copy of the raw bytes just read */
+static size_t md_scratch_cap = 0;
+
+static unsigned char *md_ovf = NULL;	/* converted bytes that did not fit yet */
+static size_t md_ovf_len = 0;
+static size_t md_ovf_cap = 0;
+
+static int
+md_is_enabled(void)
+{
+    if (md_enabled < 0) {
+	const char *env = getenv("MDTERM");
+	md_enabled = !(env != NULL && (*env == '0' || *env == 'n' || *env == 'N'));
+	if (md_enabled) {
+	    const char *ms = getenv("MDTERM_HOLD_MS");
+	    md_state = mdterm_new();
+	    if (ms != NULL && atol(ms) > 0)
+		md_hold_usec = atol(ms) * 1000L;
+	    ms = getenv("MDTERM_STREAM_MS");
+	    if (ms != NULL && atol(ms) > 0)
+		md_stream_usec = atol(ms) * 1000L;
+	}
+    }
+    return md_enabled;
+}
+
+static size_t
+md_room(const PtyData *data)
+{
+    size_t used = (size_t) (data->last - data->buffer);
+    size_t total = (size_t) (BUF_SIZE + FRG_SIZE);
+    return (used < total) ? (total - used) : 0;
+}
+
+/* MDTERM_DEBUG=/path/file : log every chunk read from the pty and what we
+ * hand to xterm instead (control bytes shown as \\xNN), to diagnose programs. */
+static FILE *md_dbg = NULL;
+static int md_dbg_tried = 0;
+
+static void
+md_log(const char *tag, const unsigned char *p, size_t n)
+{
+    size_t i;
+    if (!md_dbg_tried) {
+	const char *path = getenv("MDTERM_DEBUG");
+	md_dbg_tried = 1;
+	if (path != NULL && *path != '\0')
+	    md_dbg = fopen(path, "a");
+    }
+    if (md_dbg == NULL)
+	return;
+    fprintf(md_dbg, "%s ", tag);
+    for (i = 0; i < n; ++i) {
+	unsigned char c = p[i];
+	if (c == '\n')
+	    fputs("\\n\n     ", md_dbg);
+	else if (c == '\r')
+	    fputs("\\r", md_dbg);
+	else if (c == '\\')
+	    fputs("\\\\", md_dbg);
+	else if ((c >= 0x20 && c < 0x7f) || c >= 0x80)
+	    fputc(c, md_dbg);
+	else
+	    fprintf(md_dbg, "\\x%02x", c);
+    }
+    fputc('\n', md_dbg);
+    fflush(md_dbg);
+}
+
+static void
+md_ovf_append(const unsigned char *src, size_t n)
+{
+    if (md_ovf_len + n > md_ovf_cap) {
+	size_t want = md_ovf_len + n + 4096;
+	unsigned char *p = (unsigned char *) realloc(md_ovf, want);
+	if (p == NULL)
+	    return;		/* out of memory: drop rather than crash */
+	md_ovf = p;
+	md_ovf_cap = want;
+    }
+    memcpy(md_ovf + md_ovf_len, src, n);
+    md_ovf_len += n;
+}
+
+/*
+ * Append n bytes after the `*off` bytes already staged at data->last.
+ * Whatever does not fit in the fixed-size PtyData buffer goes to the
+ * overflow queue and is delivered later by mdterm_hook_flush_due().
+ * data->last itself is NOT moved here; the caller does that once.
+ */
+static void
+md_emit(PtyData *data, size_t *off, const unsigned char *src, size_t n)
+{
+    if (md_ovf_len == 0) {
+	size_t room = md_room(data);
+	size_t fit;
+	room = (room > *off) ? (room - *off) : 0;
+	fit = (n < room) ? n : room;
+	if (fit) {
+	    memcpy(data->last + *off, src, fit);
+	    *off += fit;
+	    src += fit;
+	    n -= fit;
+	}
+    }
+    if (n)
+	md_ovf_append(src, n);
+}
+
+/* Called from v_write(): the user (or a query reply) just wrote to the pty. */
+void
+mdterm_hook_note_input(void)
+{
+    gettimeofday(&md_last_key, NULL);
+}
+
+static long
+md_usec_since(const struct timeval *then, const struct timeval *now)
+{
+    return (long) (now->tv_sec - then->tv_sec) * 1000000L
+	+ (long) (now->tv_usec - then->tv_usec);
+}
+
+/*
+ * How long a held partial line may sit idle before it is shown as-is.
+ * Short for anything that looks like a prompt / typed echo, long for prose
+ * so that slow token streams (LLMs) are still converted a whole line at a time.
+ */
+static long
+md_limit_usec(const struct timeval *now)
+{
+    int cls = mdterm_hold_class(md_state);	/* 1 prompt/echo, 2 slow stream, 0 other */
+    if (cls == 1)
+	return MDTERM_SHORT_USEC;
+    if (md_last_key.tv_sec != 0 && md_usec_since(&md_last_key, now) < MDTERM_KEY_USEC)
+	return MDTERM_SHORT_USEC;
+    if (cls == 2)
+	return md_stream_usec;
+    return md_hold_usec;
+}
+
+static void
+md_touch(void)
+{
+    if (md_state != NULL && mdterm_pending_len(md_state) > 0) {
+	md_holding = 1;
+	gettimeofday(&md_last_input, NULL);
+    } else {
+	md_holding = 0;
+    }
+}
+
+static int
+md_has_altscreen_switch(const unsigned char *buf, size_t len)
+{
+    static const char *const seqs[] =
+    {"\033[?1049h", "\033[?1047h", "\033[?47h"};
+    size_t i, k;
+
+    for (i = 0; i < len; ++i) {
+	if (buf[i] != 0x1b)
+	    continue;
+	for (k = 0; k < sizeof(seqs) / sizeof(seqs[0]); ++k) {
+	    size_t n = strlen(seqs[k]);
+	    if (len - i >= n && memcmp(buf + i, seqs[k], n) == 0)
+		return 1;
+	}
+    }
+    return 0;
+}
+
+/*
+ * Called from readPtyData() right after read(): the `size` raw bytes sit at
+ * data->last.  Returns how many bytes should end up there (may be 0 while a
+ * partial line is being held back).
+ */
+static size_t
+md_filter(XtermWidget xw, PtyData *data, size_t size)
+{
+    size_t off = 0;
+    size_t out_len = 0;
+    unsigned char *out;
+    int active;
+
+    if (!md_is_enabled())
+	return size;
+
+    /* full-screen programs (vim, less, htop...) live on the alt screen; the
+     * switch may arrive in this very chunk, before xterm's parser saw it */
+    active = (TScreenOf(xw)->whichBuf == 0)
+	&& !md_has_altscreen_switch(data->last, size);
+
+    if (!active && !md_holding && md_ovf_len == 0)
+	return size;		/* fast path: nothing to do */
+
+    if (size > md_scratch_cap) {
+	unsigned char *p = (unsigned char *) realloc(md_scratch, size);
+	if (p == NULL)
+	    return size;
+	md_scratch = p;
+	md_scratch_cap = size;
+    }
+    memcpy(md_scratch, data->last, size);
+    md_log("IN ", md_scratch, size);
+
+    if (!active) {
+	/* leaving markdown mode: release what we held, then raw bytes */
+	out = mdterm_flush(md_state, &out_len);
+	if (out != NULL) {
+	    md_emit(data, &off, out, out_len);
+	    mdterm_free_buf(out, out_len);
+	}
+	md_emit(data, &off, md_scratch, size);
+	md_holding = 0;
+	return off;
+    }
+
+    mdterm_set_width(md_state, (size_t) (TScreenOf(xw)->max_col + 1));
+    out = mdterm_feed(md_state, md_scratch, size, &out_len);
+    if (out != NULL) {
+	md_log("OUT", out, out_len);
+	md_emit(data, &off, out, out_len);
+	mdterm_free_buf(out, out_len);
+    }
+    md_touch();
+    return off;
+}
+
+/*
+ * Called from in_put() on every pass: deliver overflow, or flush a partial
+ * line that has been idle too long (shell prompt, typed characters...).
+ * Returns non-zero if new bytes were appended to `data`.
+ */
+int
+mdterm_hook_flush_due(XtermWidget xw, PtyData *data)
+{
+    size_t off = 0;
+
+    if (md_state == NULL || !md_enabled)
+	return 0;
+
+    trimPtyData(xw, data);
+
+    if (md_ovf_len != 0) {
+	size_t room = md_room(data);
+	size_t n = (md_ovf_len < room) ? md_ovf_len : room;
+	if (n) {
+	    memcpy(data->last, md_ovf, n);
+	    memmove(md_ovf, md_ovf + n, md_ovf_len - n);
+	    md_ovf_len -= n;
+	    off = n;
+	}
+    } else if (md_holding) {
+	struct timeval now;
+	long idle;
+	gettimeofday(&now, NULL);
+	idle = md_usec_since(&md_last_input, &now);
+	if (idle >= md_limit_usec(&now)) {
+	    size_t out_len = 0;
+	    unsigned char *out = mdterm_flush(md_state, &out_len);
+	    if (out != NULL) {
+		md_log("FLUSH(idle, shown raw)", out, out_len);
+		md_emit(data, &off, out, out_len);
+		mdterm_free_buf(out, out_len);
+	    }
+	    md_holding = 0;
+	}
+    }
+    data->last += off;
+    return (off != 0);
+}
+
+/* Microseconds in_put() may sleep in select(), or -1 for "no limit". */
+long
+mdterm_hook_wait_usec(void)
+{
+    if (md_state == NULL || !md_enabled)
+	return -1;
+    if (md_ovf_len != 0)
+	return 1;
+    if (md_holding) {
+	struct timeval now;
+	long idle, left;
+	gettimeofday(&now, NULL);
+	idle = md_usec_since(&md_last_input, &now);
+	left = md_limit_usec(&now) - idle;
+	return (left > 1) ? left : 1;
+    }
+    return -1;
+}
